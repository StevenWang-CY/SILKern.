 "script": "\"\"\"Same-process comparison of the record-09 MLX sources with the current ones.\n\nRun from the repository root on Apple silicon, one fresh process per session:\n\n    python ab_post_audit.py <record-09 mlx.py.txt> <output.json>\n\nBoth implementations are loaded into one process and timed on identical inputs\nwith the record-09 protocol: every arm is compiled, checked against the Python\noracle, warmed up, then timed in 12 rotating-order blocks of 50 synchronized\ncalls. Interleaving the arms cancels slow drift in machine load, so the ratio\nof the two implementations is meaningful even where absolute latency is not.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport importlib.util\nimport json\nimport os\nimport platform\nimport statistics\nimport sys\nfrom pathlib import Path\n\nimport mlx.core as mx\n\nimport silkern\nimport silkern.mlx as current\nfrom bench.bench_mlx import _case, _measure, _summarize\nfrom silkern import localize_reference\n\nGEOMETRY = dict(block_size=64, dcp_size=2, dcp_rank=0)\nWIDTHS, BATCHES = (128, 2048, 4096), (1, 8, 32)\nWARMUP, ITERATIONS, BLOCKS, SEED = 10, 50, 12, 11\n\n\ndef _load_baseline(path: Path):\n    \"\"\"The archived module, with its Metal kernel renamed so MLX caches it apart.\"\"\"\n    source = path.read_text()\n    renamed = source.replace('name=\"silkern_localize_int32\"', 'name=\"silkern_localize_int32_r09\"')\n    assert renamed != source, \"the archived kernel name was not found\"\n    spec = importlib.util.spec_from_loader(\"silkern_mlx_record09\", loader=None)\n    module = importlib.util.module_from_spec(spec)\n    exec(compile(renamed, str(path), \"exec\"), module.__dict__)\n    return module, hashlib.sha256(source.encode()).hexdigest()\n\n\ndef main() -> int:\n    baseline_path, output = Path(sys.argv[1]), Path(sys.argv[2])\n    baseline, baseline_sha = _load_baseline(baseline_path)\n    stream = mx.default_stream(mx.gpu)\n    load_before = os.getloadavg()\n    cells = []\n    for width in WIDTHS:\n        for batch in BATCHES:\n            req, table, rows = _case(width, batch, GEOMETRY[\"block_size\"],\n                                     GEOMETRY[\"dcp_size\"], SEED)\n            expected = localize_reference(req, table, rows, **GEOMETRY)\n            arrays = [mx.array(values, dtype=mx.int32) for values in (req, table, rows)]\n            mx.eval(*arrays)\n            arms = {}\n            for label, module in ((\"record09\", baseline), (\"current\", current)):\n                for backend in (\"mlx\", \"metal\"):\n                    function = mx.compile(\n                        lambda r, t, x, module=module, backend=backend: module.localize_mlx(\n                            r, t, x, **GEOMETRY, backend=backend, stream=stream\n                        )\n                    )\n                    out, counts = function(*arrays)\n                    mx.eval(out, counts)\n                    assert (out.tolist(), counts.tolist()) == expected, (label, backend)\n                    arms[f\"{label}_{backend}_compiled\"] = (\n                        lambda function=function: function(*arrays)\n                    )\n            samples, schedule = _measure(mx, arms, warmup=WARMUP, iterations=ITERATIONS,\n                                         blocks=BLOCKS, stream=stream)\n            medians = {name: statistics.median(values) for name, values in samples.items()}\n            cells.append({\n                \"geometry\": {\"width\": width, \"batch\": batch, **GEOMETRY},\n                \"oracle_passed\": True,\n                \"results\": {name: _summarize(values) for name, values in samples.items()},\n                \"schedule\": schedule,\n                \"current_over_record09\": {\n                    backend: medians[f\"current_{backend}_compiled\"]\n                    / medians[f\"record09_{backend}_compiled\"]\n                    for backend in (\"mlx\", \"metal\")\n                },\n            })\n    report = {\n        \"schema_version\": 1,\n        \"diagnostic\": \"same-process A/B of record-09 and current MLX localization sources\",\n        \"metadata\": {\n            \"platform\": platform.platform(),\n            \"python\": platform.python_version(),\n            \"versions\": {\"silkern\": silkern.__version__, \"mlx\": mx.__version__},\n            \"device\": mx.device_info(mx.gpu),\n            \"load_average_before\": load_before,\n            \"load_average_after\": os.getloadavg(),\n            \"source_sha256\": {\n                \"record09 silkern/mlx.py\": baseline_sha,\n                \"current silkern/mlx.py\": hashlib.sha256(\n                    Path(current.__file__).read_bytes()).hexdigest(),\n                \"bench/bench_mlx.py\": hashlib.sha256(\n                    Path(\"bench/bench_mlx.py\").read_bytes()).hexdigest(),\n            },\n        },\n        \"methodology\": {\n            \"measurement\": \"synchronized end-to-end compiled functional call\",\n            \"units\": \"microseconds per call\",\n            \"order\": \"rotate arm order each block\",\n            \"warmup\": WARMUP, \"iterations_per_block\": ITERATIONS, \"blocks\": BLOCKS,\n            \"seed\": SEED, \"fixture\": \"bench.bench_mlx._case\",\n        },\n        \"script\": Path(__file__).read_text(),\n        \"cells\": cells,\n    }\n    output.write_text(json.dumps(report, indent=1) + \"\\n\")\n    for cell in cells:\n        geometry, ratio = cell[\"geometry\"], cell[\"current_over_record09\"]\n        print(f\"{geometry['width']:>5} x {geometry['batch']:>2}: \"\n              f\"mlx {ratio['mlx']:.3f}  metal {ratio['metal']:.3f}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n",
